#!/bin/bash
# Wrapper to run oracle-code

REPO_ROOT="$(cd "$(dirname "$0")"; pwd)"
BINARY="$REPO_ROOT/packages/oracle-code/dist/ocode-darwin-arm64/bin/ocode"

# Use built binary if available
if [[ -x "$BINARY" ]]; then
  exec "$BINARY" "$@"
fi

# Fall back to running from source
# Pass original working directory via env var since --cwd changes process.cwd()
export PATH="$HOME/.bun/bin:$PATH"
export OCODE_CWD="$PWD"
exec bun run --cwd "$REPO_ROOT/packages/oracle-code" --conditions=browser src/index.ts "$@"
